# Backend production environment variables

# PostgreSQL connection string from Neon, Supabase, Render, or local PostgreSQL
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# JWT secret key. Use a long random string and never commit real secrets.
JWT_SECRET=replace_with_a_random_string_longer_than_32_chars

# Google Gemini API key (optional for local demo)
GEMINI_API_KEY=

# URL bảng điểm DAA. Giữ {mssv} để backend thay bằng MSSV của tài khoản đăng nhập.
DAA_GRADE_URL_TEMPLATE=https://daa.uit.edu.vn/print/sinhvien/kqhoctap/?sid={mssv}

# URL Thời khoá biểu + Lịch thi DAA (đồng bộ cùng lúc với điểm khi đăng nhập DAA).
# Có thể dùng {mssv}. Nếu DAA có bản /print/... thì thay vào để parse ổn định hơn.
DAA_TKB_URL_TEMPLATE=https://daa.uit.edu.vn/sinhvien/tkb
DAA_EXAM_URL_TEMPLATE=https://daa.uit.edu.vn/sinhvien/lichhoc/lichthi

# Brevo HTTP API key (KHUYẾN NGHỊ cho deploy: gửi qua HTTPS 443, không bị chặn SMTP).
# Có BREVO_API_KEY thì backend ưu tiên Brevo, bỏ qua SMTP bên dưới. Sender (SMTP_FROM)
# phải là email đã verify trong Brevo. Lấy ở: brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=

# Gmail SMTP / App Password — chỉ dùng làm fallback khi KHÔNG có BREVO_API_KEY (vd chạy local).
# Lưu ý: nhiều host (Render free) chặn cổng SMTP nên SMTP sẽ timeout — khi đó dùng Brevo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=advisorhub@example.com
SMTP_PASS=app_password_do_not_commit
SMTP_FROM=AdvisorHub <advisorhub@example.com>

# Tự động email cảnh báo học vụ tới sinh viên khi phát hiện bất thường mới.
# Đặt false để tắt; throttle tính theo giờ (mặc định 12) để tránh spam một sinh viên.
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_THROTTLE_HOURS=12

# Email thông báo khi có TIN NHẮN mới. Chỉ gửi khi người nhận đang offline và
# không quá 1 email/người-gửi trong khoảng throttle (phút) để tránh spam.
MESSAGE_EMAIL_ENABLED=false
MESSAGE_EMAIL_THROTTLE_MINUTES=10

# Render sets PORT automatically. Local default is 4000.
# PORT=4000

# Frontend origins allowed to call the backend, comma-separated for multiple origins.
ALLOWED_ORIGINS=http://localhost:5173
