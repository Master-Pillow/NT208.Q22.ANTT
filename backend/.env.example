# =============================================================
# BACKEND — PRODUCTION ENV VARS (nhập vào Render Dashboard)
# =============================================================

# PostgreSQL connection string từ Neon.tech hoặc Supabase
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# JWT secret key — dùng chuỗi ngẫu nhiên dài (không để mặc định)
JWT_SECRET=thay_bang_chuoi_ngau_nhien_dai_hon_32_ky_tu

# Google Gemini API Key
GEMINI_API_KEY=AIzaSy...

# Port (Render tự set PORT, không cần set tay)
# PORT=4000

# CORS — URL của frontend deploy trên Vercel (cách nhau bằng dấu phẩy nếu có nhiều)
ALLOWED_ORIGINS=https://advisorhub.vercel.app
